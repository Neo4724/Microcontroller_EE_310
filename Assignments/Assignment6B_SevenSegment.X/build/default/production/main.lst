 29484                           ; Program Constants
 29485                           ;---------------------
 29486  0010                     SEG0            equ	16	;7-Segment zero
 29487  001F                     SEGF            equ	31	;7-Segment f
 29488  0020                     AND1            equ	32	;Holds bit for ANDED portion
 29489  0021                     REG21           equ	33	;Both reg21, reg22, reg23 are used in the loopDelay
 29490  0022                     REG22           equ	34
