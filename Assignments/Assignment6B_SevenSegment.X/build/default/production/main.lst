 29494                           ; Setup & Main Program
 29495                           ;---------------------
 29496                           
 29497                           	psect	absdata
 29498  0020                     	org	32
 29499  0020  0E03               	movlw	3
 29500  0022  6EC3               	movwf	16323,c
 29501  0024  0E00               	movlw	0
 29502  0026  6ECB               	movwf	16331,c	;Initializing PORTB
 29503  0028  6EC5               	movwf	16325,c
 29504  002A  6ECD               	movwf	16333,c	;Initializing PORTD
 29505  002C  6E20               	movwf	32,c	;Buffer reg for ANDED portion
 29506  002E  EE00 F010          	lfsr	0,16	;Initializing FSR0L to SEG0
 29507  0032  0E3F               	movlw	63	;Setting reg10 as 7-Segment 0
 29508  0034  6E10               	movwf	16,c
 29509  0036  0E06               	movlw	6	;Setting reg11 as 7-Segment 1
 29510  0038  6E11               	movwf	17,c
 29511  003A  0E5B               	movlw	91	;Setting reg12 as 7-Segment 2
 29512  003C  6E12               	movwf	18,c
 29513  003E  0E4F               	movlw	79	;Setting reg13 as 7-Segment 3
 29514  0040  6E13               	movwf	19,c
 29515  0042  0E66               	movlw	102	;Setting reg14 as 7-Segment 4
 29516  0044  6E14               	movwf	20,c
 29517  0046  0E6D               	movlw	109	;Setting reg15 as 7-Segment 5
 29518  0048  6E15               	movwf	21,c
 29519  004A  0E7D               	movlw	125	;Setting reg16 as 7-Segment 6
 29520  004C  6E16               	movwf	22,c
 29521  004E  0E07               	movlw	7	;Setting reg17 as 7-Segment 7
 29522  0050  6E17               	movwf	23,c
 29523  0052  0E7F               	movlw	127	;Setting reg18 as 7-Segment 8
 29524  0054  6E18               	movwf	24,c
 29525  0056  0E6F               	movlw	111	;Setting reg19 as 7-Segment 9
 29526  0058  6E19               	movwf	25,c
 29527  005A  0E77               	movlw	119	;Setting reg1A as 7-Segment A
 29528  005C  6E1A               	movwf	26,c
 29529  005E  0E7C               	movlw	124	;Setting reg1B as 7-Segment B
 29530  0060  6E1B               	movwf	27,c
 29531  0062  0E39               	movlw	57	;Setting reg1C as 7-Segment C
 29532  0064  6E1C               	movwf	28,c
 29533  0066  0E5E               	movlw	94	;Setting reg1D as 7-Segment D
 29534  0068  6E1D               	movwf	29,c
 29535  006A  0E79               	movlw	121	;Setting reg1E as 7-Segment E
 29536  006C  6E1E               	movwf	30,c
 29537  006E  0E71               	movlw	113	;Setting reg1F as 7-Segment F
 29538  0070  6E1F               	movwf	31,c
 29539  0072  50EF               	movf	indf0,w,c	;Initially loads FSR with value 0
 29540  0074  6EBD               	movwf	16317,c	;Displays FSR value to the 7-segment
 29541  0076                     MainLoop:
 29542  0076  A2CB               	btfss	16331,1,c	;Checks if PORTB,1 is pressed
 29543  0078  EF5D F000          	goto	CheckButton
 29544  007C  A0CB               	btfss	16331,0,c	;Checks if PORTB,0 is pressed
 29545  007E  EF5D F000          	goto	CheckButton
 29546  0082  EF43 F000          	goto	Zero
 29547  0086                     Zero:
 29548  0086  EE00 F010          	lfsr	0,16	;Loads FSR with value of 0
 29549  008A  EF65 F000          	goto	DisplaySeg
 29550  008E                     Max:
 29551  008E  EE00 F01F          	lfsr	0,31	;Loads FSR with value of F
 29552  0092  EF65 F000          	goto	DisplaySeg
 29553  0096                     Increment:
 29554  0096  50EF               	movf	indf0,w,c
 29555  0098  621F               	cpfseq	31,c	;Checks if FSR is at value F, if so it sets FSR to
 29556  009A  EF51 F000          	goto	Increase	; value 0. If not, it increments FSR by one.
 29557  009E  EF43 F000          	goto	Zero
 29558  00A2                     Increase:
 29559  00A2  2AE9               	incf	fsr0l,f,c
 29560  00A4  EF65 F000          	goto	DisplaySeg
 29561  00A8                     Decrement:
 29562  00A8  50EF               	movf	indf0,w,c
 29563  00AA  6210               	cpfseq	16,c	;Checks if FSR is at value 0, if so it sets FSR to
 29564  00AC  EF5A F000          	goto	Decrease	; value F. If not, it decrements FSR by one.
 29565  00B0  EF47 F000          	goto	Max
 29566  00B4                     Decrease:
 29567  00B4  06E9               	decf	fsr0l,f,c
 29568  00B6  EF65 F000          	goto	DisplaySeg
 29569  00BA                     CheckButton:
 29570  00BA  B2CB               	btfsc	16331,1,c	;Checks if PORTB,1 is not pressed, goes to increment if it is
 29571  00BC  EF4B F000          	goto	Increment
 29572  00C0  B0CB               	btfsc	16331,0,c	;Checks if PORTB,0 is not pressed, goes to decrement if it is
 29573  00C2  EF54 F000          	goto	Decrement
 29574  00C6  EF3B F000          	goto	MainLoop	;Loop continues indefinately
 29575  00CA                     DisplaySeg:
 29576  00CA  50EF               	movf	indf0,w,c	;Reads FSR value and sends it to 7-segment
 29577  00CC  6EBD               	movwf	16317,c
 29578  00CE  EC6B F000          	call	loopDelay	;Delays program for 0.2 to 1 second
 29579  00D2  EF3B F000          	goto	MainLoop
 29580  00D6                     loopDelay:
 29581  00D6  0E64               	movlw	100
 29582  00D8  6E21               	movwf	33,c
 29583  00DA  0E64               	movlw	100
 29584  00DC  6E22               	movwf	34,c
 29585  00DE  0E08               	movlw	8
 29586  00E0  6E23               	movwf	35,c
 29587  00E2                     _loop1:
 29588  00E2  0621               	decf	33,f,c
 29589  00E4  E1FE               	bnz	_loop1
 29590  00E6  0E64               	movlw	100	; Re-initialize the inner loop for when the outer loop decrements.
 29591  00E8  6E21               	movwf	33,c
 29592  00EA  0622               	decf	34,f,c
 29593  00EC  E1FA               	bnz	_loop1
 29594  00EE  0E64               	movlw	100	; Re-initialize the outer loop for when the upper loop decrements.
 29595  00F0  6E22               	movwf	34,c
 29596  00F2  0623               	decf	35,f,c
 29597  00F4  0012               	return	
 29598                           
 29599                           	psect	config
 29600                           
 29601                           ;Config register CONFIG1L @ 0x300000
 29602                           ;	External Oscillator Selection
 29603                           ;	FEXTOSC = LP, LP (crystal oscillator) optimized for 32.768 kHz; PFM set to low power
 29604                           ;	Reset Oscillator Selection
 29605                           ;	RSTOSC = EXTOSC, EXTOSC operating per FEXTOSC bits (device manufacturing default)
 29606  300000                     	org	3145728
 29607  300000  F8                 	db	248
 29608                           
 29609                           ;Config register CONFIG1H @ 0x300001
 29610                           ;	Clock out Enable bit
 29611                           ;	CLKOUTEN = OFF, CLKOUT function is disabled
 29612                           ;	PRLOCKED One-Way Set Enable bit
 29613                           ;	PR1WAY = ON, PRLOCK bit can be cleared and set only once
 29614                           ;	Clock Switch Enable bit
 29615                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 29616                           ;	Fail-Safe Clock Monitor Enable bit
 29617                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 29618  300001                     	org	3145729
 29619  300001  FF                 	db	255
 29620                           
 29621                           ;Config register CONFIG2L @ 0x300002
 29622                           ;	MCLR Enable bit
 29623                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 29624                           ;	Power-up timer selection bits
 29625                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 29626                           ;	Multi-vector enable bit
 29627                           ;	MVECEN = ON, Multi-vector enabled, Vector table used for interrupts
 29628                           ;	IVTLOCK bit One-way set enable bit
 29629                           ;	IVT1WAY = ON, IVTLOCK bit can be cleared and set only once
 29630                           ;	Low Power BOR Enable bit
 29631                           ;	LPBOREN = OFF, ULPBOR disabled
 29632                           ;	Brown-out Reset Enable bits
 29633                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 29634  300002                     	org	3145730
 29635  300002  FF                 	db	255
 29636                           
 29637                           ;Config register CONFIG2H @ 0x300003
 29638                           ;	Brown-out Reset Voltage Selection bits
 29639                           ;	BORV = VBOR_2P45, Brown-out Reset Voltage (VBOR) set to 2.45V
 29640                           ;	ZCD Disable bit
 29641                           ;	ZCD = OFF, ZCD disabled. ZCD can be enabled by setting the ZCDSEN bit of ZCDCON
 29642                           ;	PPSLOCK bit One-Way Set Enable bit
 29643                           ;	PPS1WAY = ON, PPSLOCK bit can be cleared and set only once; PPS registers remain locked after one 
      +                          clear/set cycle
 29644                           ;	Stack Full/Underflow Reset Enable bit
 29645                           ;	STVREN = ON, Stack full/underflow will cause Reset
 29646                           ;	Debugger Enable bit
 29647                           ;	DEBUG = OFF, Background debugger disabled
 29648                           ;	Extended Instruction Set Enable bit
 29649                           ;	XINST = OFF, Extended Instruction Set and Indexed Addressing Mode disabled
 29650  300003                     	org	3145731
 29651  300003  FF                 	db	255
 29652                           
 29653                           ;Config register CONFIG3L @ 0x300004
 29654                           ;	WDT Period selection bits
 29655                           ;	WDTCPS = WDTCPS_31, Divider ratio 1:65536; software control of WDTPS
 29656                           ;	WDT operating mode
 29657                           ;	WDTE = OFF, WDT Disabled; SWDTEN is ignored
 29658  300004                     	org	3145732
 29659  300004  9F                 	db	159
 29660                           
 29661                           ;Config register CONFIG3H @ 0x300005
 29662                           ;	WDT Window Select bits
 29663                           ;	WDTCWS = WDTCWS_7, window always open (100%); software control; keyed access not required
 29664                           ;	WDT input clock selector
 29665                           ;	WDTCCS = SC, Software Control
 29666  300005                     	org	3145733
 29667  300005  FF                 	db	255
 29668                           
 29669                           ;Config register CONFIG4L @ 0x300006
 29670                           ;	Boot Block Size selection bits
 29671                           ;	BBSIZE = BBSIZE_512, Boot Block size is 512 words
 29672                           ;	Boot Block enable bit
 29673                           ;	BBEN = OFF, Boot block disabled
 29674                           ;	Storage Area Flash enable bit
 29675                           ;	SAFEN = OFF, SAF disabled
 29676                           ;	Application Block write protection bit
 29677                           ;	WRTAPP = OFF, Application Block not write protected
 29678  300006                     	org	3145734
 29679  300006  FF                 	db	255
 29680                           
 29681                           ;Config register CONFIG4H @ 0x300007
 29682                           ;	Boot Block Write Protection bit
